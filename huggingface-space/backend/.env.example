# ============================================================
# PhishGuard AI — Konfiguratsiya parametrlari (.env)
# ============================================================

# 1. Tashqi Tahdidlar Razvedkasi (VirusTotal API v3)
VIRUSTOTAL_API_KEY=YOUR_API_KEY_HERE

# 2. Telegram SOC Bot Tokeni
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 3. Taqsimlangan Kesh & Rate Limiter (Redis)
# Agar Redis ishlatilmasa, tizim avtomatik ravishda in-memory fallback rejimiga o'tadi
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# 4. Korporativ SOC Autentifikatsiya (RBAC)
# Ochiq/o'quv rejimida ishlash uchun 'false', productionda qat'iy tekshiruv uchun 'true'
API_KEY_REQUIRED=false
PHISHGUARD_ADMIN_KEY=pg-admin-supersecret-token
PHISHGUARD_ANALYST_KEY=pg-analyst-soc-token
PHISHGUARD_VIEWER_KEY=pg-viewer-public-token

# 5. Dinamik Qumloq (CAPE / Cuckoo Sandbox)
SANDBOX_API_URL=
SANDBOX_API_TOKEN=
SANDBOX_TIMEOUT=15
